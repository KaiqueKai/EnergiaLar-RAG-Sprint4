# Copie este arquivo para .env e preencha sua chave. Nunca publique .env.
OLLAMA_API_KEY=COLE_SUA_CHAVE_AQUI

# Variáveis preservadas pela versão pública da Sprint 3 de EnergiaLar.
OLLAMA_BASE_URL=https://ollama.com
MODEL_PRIMARY=gpt-oss:20b
MODEL_SECONDARY=gemma4:31b

# API de chat Ollama Cloud. gemma4:31b fica como principal pois já respondeu OK no teste real.
# gpt-oss:20b é usado na Sprint 3 e serve como segundo modelo de comparação. Na API Cloud direta usa-se o nome sem o sufixo CLI -cloud; valide a disponibilidade e o uso antes da avaliação.
OLLAMA_HOST=https://ollama.com
CHAT_MODEL=gemma4:31b
COMPARISON_MODELS=gemma4:31b,gpt-oss:20b

# Limitação oficial verificada em 2026: Ollama Cloud aceita chat, mas não expõe embeddings.
# Mantemos o modelo exigido e usamos Ollama local só para criar vetores.
# Isso é um desvio literal do trecho Cloud do PDF; veja docs/COMPATIBILIDADE_EMBEDDINGS_CLOUD.md.
# Depois de instalar/iniciar Ollama no Windows, execute: ollama pull nomic-embed-text
EMBEDDING_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

CHROMA_PERSIST_DIR=storage/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8
MIN_RELEVANCE_SCORE=0.15
TEMPERATURE=0.0
TOP_P=0.9
MAX_TOKENS=600
